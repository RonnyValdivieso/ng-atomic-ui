# Stage 1: Build the Angular application
FROM --platform=linux/arm64 node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies.
RUN npm install --no-save --no-audit --no-fund --loglevel=error

# Copy application source
COPY . .

# Build the application for staging
RUN npm run build:staging

# Stage 2: Serve with nginx
FROM --platform=linux/arm64 nginx:alpine

# envsubst (from gettext) is required to populate assets/env-config.js at startup
RUN apk add --no-cache gettext

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built application from build stage
COPY --from=build /app/dist/ng-atomic-ui/browser /usr/share/nginx/html

# Entrypoint that runs envsubst on the runtime config template before launching nginx
COPY scripts/env.sh /env.sh
RUN chmod +x /env.sh

# Expose port 80
EXPOSE 80

CMD ["/env.sh"]
